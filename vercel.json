{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cp scripts/install.sh landing/install.sh",
  "outputDirectory": "landing",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/404.html", "status": 404 }
  ]
}
